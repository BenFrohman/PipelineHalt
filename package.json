{
  "name": "pipelinehalt",
  "version": "0.4.0",
  "description": "PipelineHalt: compare paper claims (anchor) against Lean statements (live artifact); halt and ask on mismatch.",
  "license": "MIT",
  "author": "Benjamin Stanley Frohman <frohmanbenjamin@gmail.com>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "pipelinehalt": "./dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenFrohman/PipelineHalt.git"
  },
  "keywords": [
    "lean",
    "lean4",
    "formalization",
    "alignment",
    "drift-detection",
    "theorem-proving"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test dist/test/*.test.js",
    "prepack": "tsc -b"
  },
  "private": true,
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}