open Lean Meta Elab Command

namespace SemanticsLock

def slPre : List Name := [`Fixture]
def slProj (env : Environment) (n : Name) : Bool :=
  match env.getModuleIdxFor? n with
  | some idx => slPre.any (·.isPrefixOf env.header.moduleNames[idx.toNat]!)
  | none => false
def slMod (env : Environment) (n : Name) : String :=
  match env.getModuleIdxFor? n with
  | some idx => (env.header.moduleNames[idx.toNat]!).toString
  | none => "?"
def slHash (ci : ConstantInfo) : UInt64 :=
  mixHash ci.type.hash (match ci.value? (allowOpaque := true) with | some v => v.hash | none => 0)
/-- Project-local constants reachable from `roots` through values (and types if `withTypes`). -/
def slClosure (env : Environment) (roots : List Name) (withTypes : Bool) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut todo := roots
  for _ in [0:4000000] do
    match todo with
    | [] => break
    | n :: rest =>
      todo := rest
      if seen.contains n then continue
      seen := seen.insert n
      if let some ci := env.find? n then
        let vs := match ci.value? (allowOpaque := true) with | some v => v.getUsedConstants | none => #[]
        let ts := if withTypes then ci.type.getUsedConstants else #[]
        for c in vs ++ ts do
          if slProj env c && !seen.contains c then todo := c :: todo
  return seen

partial def slIsId : Expr → Bool
  | .mdata _ e => slIsId e
  | .lam _ _ b _ => b.consumeMData == .bvar 0 || slIsId b.consumeMData
  | e => e.getAppFn.consumeMData.isConstOf ``id
def slTrivial (v : Expr) : Option String :=
  let v := v.consumeMData
  let f := v.getAppFn.consumeMData
  let triv := [``Iff.rfl, ``Iff.refl, ``rfl, ``Eq.refl, ``id, ``HEq.refl]
  if triv.any f.isConstOf then some s!"proof term is {f}"
  else if f.isConstOf ``Iff.of_eq && v.getAppNumArgs ≥ 3 &&
      [``rfl, ``Eq.refl].any (v.getArg! 2).getAppFn.consumeMData.isConstOf then some "proof term is Iff.of_eq rfl"
  else if f.isConstOf ``Iff.intro && v.getAppNumArgs == 4 && slIsId (v.getArg! 2) && slIsId (v.getArg! 3) then
    some "proof term is Iff.intro of two identity functions"
  else if slIsId v then some "proof term is an identity function"
  else none

def slWhitelist : List Name := [`Fixture.headline]

#eval show CommandElabM Unit from liftTermElabM do
  let env ← getEnv
  let std := [``propext, ``Classical.choice, ``Quot.sound]
  let P := `Fixture.paper_claim
  let C := `Fixture.intended_correspondence
  let F := `Fixture.formal_claim
